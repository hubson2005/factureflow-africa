# Clés du projet Supabase de l'ERP (à récupérer dans Project Settings > API)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=votre-anon-key

# Ces deux-là sont utilisées côté Edge Function (secrets serveur, PAS dans le front)
# A définir avec: supabase secrets set NOM=valeur
# SUPABASE_SERVICE_ROLE_KEY=...
# FACTUREFLOW_WEBHOOK_SECRET=...   (la clé API générée dans FactureFlow > Integrations)
# DEFAULT_ENTREPOT_ID=...          (uuid de l'entrepôt par défaut, une fois créé)
